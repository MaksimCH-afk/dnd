# --- App-сервер (hosted) ---
#
# ВСЁ НИЖЕ — НЕОБЯЗАТЕЛЬНО. Ключи OpenRouter, модели по ролям и пароль администратора
# можно задать прямо в игре: ⚙ Настройки → «Администрирование» (хранится в БД).
# Этот файл — лишь способ задать те же значения заранее/из окружения.

# Ключ OpenRouter (общий, по умолчанию для всех ролей). Можно задать и в админке.
OPENROUTER_API_KEY=

# (необязательно) отдельные ключи по ролям — переопределяют общий
OPENROUTER_KEY_NARRATOR=
OPENROUTER_KEY_VALIDATOR=
OPENROUTER_KEY_DIRECTOR=
OPENROUTER_KEY_FALLBACK=

# (необязательно) модели по ролям — переопределяют дефолты движка.
# Так ставится платный Ведущий без правки кода (см. docs/reference_paid_narrator_models.md):
#   OPENROUTER_MODEL_NARRATOR=qwen/qwen3.6-plus
# *_ALT — альтернатива (ручной «богаче/тяжелее»).
OPENROUTER_MODEL_NARRATOR=
OPENROUTER_MODEL_NARRATOR_ALT=
OPENROUTER_MODEL_VALIDATOR=
OPENROUTER_MODEL_DIRECTOR=
OPENROUTER_MODEL_FALLBACK=

# Postgres (с расширением pgvector). В docker-compose уже настроен.
DATABASE_URL=postgres://rpg:rpg@localhost:5432/rpg

# Порт app-сервера
PORT=8787

# CORS: origin клиента (для dev — localhost; для прод — домен/Tailscale).
# Звёздочка '*' отражает любой origin (домашняя сеть/Tailscale).
CORS_ORIGINS=*

# Эмбеддер RAG (на сервере). bge-m3 → dim 1024 (миграция БД фиксирует размерность).
EMBEDDER_MODEL=Xenova/bge-m3

# Атрибуция OpenRouter (необязательно)
OPENROUTER_REFERER=
OPENROUTER_TITLE=Text RPG
