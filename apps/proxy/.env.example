# Прокси stateless. Ключ OpenRouter обычно приходит из UI приложения
# (добавить/изменить/проверить в настройках) и НЕ обязателен здесь.
#
# OPENROUTER_API_KEY — опциональный СИД для локального запуска без ввода ключа в UI.
# Если задан и UI не прислал свой ключ — используется этот. Можно оставить пустым.
OPENROUTER_API_KEY=

# Порт прокси (по умолчанию 8787)
PORT=8787

# CORS: разрешённые origin фронтенда через запятую (по умолчанию localhost-dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Необязательно: заголовки атрибуции OpenRouter
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=Text RPG
