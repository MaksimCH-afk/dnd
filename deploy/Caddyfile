# Caddy: домен + автоматический HTTPS (Let's Encrypt) + reverse-proxy на app-сервер.
# Домен берётся из переменной CADDY_DOMAIN (docker-compose). Сертификат Caddy получает
# сам при первом запросе — нужны открытые порты 80 и 443 и A-запись домена на этот сервер.

{$CADDY_DOMAIN:dnd.korolevskie-rozy.ru} {
	encode zstd gzip

	# Весь трафик (UI, API кампаний, SSE-ход) — на app-сервер. SSE Caddy стримит сам.
	reverse_proxy server:8787

	# --- РЕКОМЕНДУЕТСЯ на публичном домене: закрыть админку и логи паролем ---
	# У админки нет своего пароля, поэтому на публичном адресе защищайте её здесь.
	# 1) хэш:  docker compose exec caddy caddy hash-password --plaintext 'ВашПароль'
	# 2) раскомментируйте и вставьте логин + хэш:
	#
	# @admin path /admin* /logs*
	# basic_auth @admin {
	# 	admin <вставьте-bcrypt-хэш>
	# }
}
